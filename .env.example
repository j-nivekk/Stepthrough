# Copy to `.env` and adjust. Every line is optional: the values shown are the defaults.
# `.env` is not committed; this example is.

# Image version: `stable` follows releases, `edge` follows the docker branch, or pin a release such as `0.2.0`.
STEPTHROUGH_TAG=stable

# Where the app listens on the host. Keep 127.0.0.1 behind nginx; use 0.0.0.0 only to expose it directly.
STEPTHROUGH_BIND_ADDRESS=127.0.0.1
STEPTHROUGH_PORT=8080

# Analyses that may run at once. Later runs wait in line as `queued`. Each run keeps one or two cores busy.
STEPTHROUGH_MAX_CONCURRENT_RUNS=2

# Largest recording accepted, in megabytes. nginx's client_max_body_size must be at least this.
STEPTHROUGH_MAX_UPLOAD_MB=1024

# Limits for the container, so analyses cannot starve other tools on the host (for example 4 and 8g). 0 is no limit.
STEPTHROUGH_CPUS=0
STEPTHROUGH_MEMORY=0

# Name of the Docker volume that holds the database, recordings, screenshots and exports.
STEPTHROUGH_VOLUME=stepthrough_data

# Text recognition (OCR) needs the `-ocr` image: set STEPTHROUGH_TAG=stable-ocr, or build with STEPTHROUGH_WITH_OCR=true.
# Models are downloaded into the volume on first use: auto, huggingface or bos.
STEPTHROUGH_WITH_OCR=false
STEPTHROUGH_OCR_MODEL_SOURCE=auto
